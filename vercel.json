{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "weinstein-analyst.vercel.app"
        }
      ],
      "destination": "https://www.alphastage.finance/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/valor/:slug",
      "destination": "/api/stock-page?slug=:slug"
    },
    {
      "source": "/a/:id",
      "destination": "/api/shared-analysis?id=:id"
    },
    {
      "source": "/sitemap-valores.xml",
      "destination": "/api/sitemap-valores"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
